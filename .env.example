# Copy to .env and adjust. Every value here can also be set as a real
# environment variable (e.g. in docker-compose.yml or a k8s Deployment) —
# env vars always win over .env / CONFIG_FILE.

LOG_LEVEL=INFO
MAX_UPLOAD_MB=500

# --- ASR (transcription) endpoint — the model-agnostic part -----------------
# Point this at ANY server that speaks the OpenAI Whisper API dialect
# (POST <url>/audio/transcriptions, multipart "file" + "model" fields):
# OpenAI itself, Groq, faster-whisper-server, LocalAI, vLLM's audio endpoint,
# a self-hosted whisper-large-v3 behind that shim, etc. The underlying model
# is entirely the endpoint's business — this worker never loads an ASR model.
ASR_BACKEND=openai_compatible
ASR_ENDPOINT_URL=http://localhost:9000/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=
ASR_REQUEST_CONCURRENCY=4

# If your ASR endpoint does NOT speak the OpenAI dialect, switch to "generic"
# and map its fields instead — see README "ASR backend" section:
# ASR_BACKEND=generic
# ASR_GENERIC_AUDIO_FIELD=audio
# ASR_GENERIC_RESPONSE_TEXT_PATH=result.text

# --- Voice activity detection ------------------------------------------------
VAD_BACKEND=webrtcvad

# --- Diarization (who spoke when, anonymously) -------------------------------
DIARIZATION_BACKEND=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_HF_TOKEN=
DIARIZATION_DEVICE=cpu

# --- Speaker embeddings (used for both diarization refinement and enrollment
#     matching) ------------------------------------------------------------
EMBEDDING_BACKEND=pyannote_embedding
EMBEDDING_MODEL=pyannote/embedding
EMBEDDING_HF_TOKEN=
EMBEDDING_DEVICE=cpu
EMBEDDING_SIMILARITY_THRESHOLD=0.75

# --- Enrolled voice profile storage ------------------------------------------
ENROLLMENT_STORE_BACKEND=file
ENROLLMENT_STORE_PATH=/data/speaker_profiles

# --- Live/streaming tuning ----------------------------------------------------
STREAMING_WINDOW_SECONDS=8.0
STREAMING_PARTIAL_EMIT_INTERVAL_SECONDS=1.5
STREAMING_FINALIZE_AFTER_SILENCE_MS=600
